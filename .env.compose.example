# Copy to an ignored local file and replace every replace-me value.
POSTGRES_DB=attention
POSTGRES_USER=attention_migration_owner
POSTGRES_PASSWORD=replace-me-owner-password
MIGRATION_DATABASE_URL=postgresql://attention_migration_owner:replace-me-owner-password@postgres:5432/attention
ATTENTION_MIGRATION_DATABASE_ROLE=attention_migration_owner
ATTENTION_MIGRATION_DATABASE_HOST=postgres
ATTENTION_MIGRATION_DATABASE_NAME=attention
ATTENTION_WEB_DATABASE_PASSWORD=replace-me-web-runtime-password
ATTENTION_WORKER_DATABASE_PASSWORD=replace-me-worker-runtime-password
DATABASE_URL=postgresql://attention_web_runtime:replace-me-web-runtime-password@postgres:5432/attention
WORKER_DATABASE_URL=postgresql://attention_worker_runtime:replace-me-worker-runtime-password@postgres:5432/attention

ATTENTION_HMAC_SECRET=replace-me-with-at-least-32-random-characters
ATTENTION_AUTH_SECRET=replace-me-with-a-different-32-character-secret
ATTENTION_CHANNEL_SECRET=replace-me-with-another-32-character-secret
ATTENTION_CHANNEL_ADAPTER_SECRET=replace-me-with-an-internal-32-character-secret
FETCHER_SHARED_SECRET=replace-me-with-a-fetcher-32-character-secret
FETCHER_MAX_CONCURRENCY=16
FETCHER_MAX_QUEUE=32
FETCHER_QUEUE_TIMEOUT_MS=1000

NEXT_PUBLIC_APP_URL=https://attention.example.com
ATTENTION_MCP_PUBLIC_URL=https://attention.example.com/mcp
ATTENTION_SYNC_PUBLIC_URL=https://attention.example.com/api/sync
PUBLIC_FEED_PREVIEW_LIMIT=20
ATTENTION_TRUSTED_CLIENT_SOURCE_HEADER=x-attention-client-source
ATTENTION_OAUTH_REGISTRATION_HOURLY_LIMIT=100
ATTENTION_OAUTH_REGISTRATION_SOURCE_HOURLY_LIMIT=10
ATTENTION_FILTER_REPORT_CASE_LIMIT_24H=10
ATTENTION_CONSUMER_INVITE_QUOTA=1
WEB_BIND_ADDRESS=127.0.0.1
WEB_PUBLISH_PORT=3000

# Default staging email mode: native Resend for the unified login OTP only.
# Replace the API key and confirm the sender/domain and template are verified.
ATTENTION_EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-me-with-a-dedicated-resend-api-key
ATTENTION_RESEND_FROM="Attention <no_reply@service.noveltystudio.cn>"
ATTENTION_RESEND_TEMPLATE_ID=attention-login-code
# Worker digests only support webhook delivery. Leave them disabled for a
# Resend-only staging deployment; configure both webhook values before enabling.
ATTENTION_EMAIL_WEBHOOK_URL=
ATTENTION_EMAIL_WEBHOOK_TOKEN=
ATTENTION_DIGEST_WORKER_ENABLED=false

# Leave ATTENTION_AI_MODEL empty for deterministic metadata and no generated summaries.
ATTENTION_AI_MODEL=
ATTENTION_AI_BASE_URL=https://api.openai.com/v1
ATTENTION_AI_API_KEY=

# Optional billing adapter. Empty means checkout is unavailable.
ATTENTION_BILLING_PROVIDER=
ATTENTION_BILLING_CHECKOUT_WEBHOOK=
ATTENTION_BILLING_WEBHOOK_SECRET=

# Optional `wechat` profile. Public/cross-host API URLs must use HTTPS; the
# Compose-internal fixed address http://web:3000 is the only HTTP service-name exception.
ATTENTION_CHANNEL_API_BASE_URL=https://attention.example.com
WECHAT_BIND_ADDRESS=127.0.0.1
WECHAT_PUBLISH_PORT=4200
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=replace-me-wechat-app-secret
WECHAT_CALLBACK_TOKEN=replace-me-callback-token
WECHAT_ENCODING_AES_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
WECHAT_MESSAGE_MODE=safe
WECHAT_ASYNC_REPLY_PROVIDER=disabled
