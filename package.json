{
  "name": "attention",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "agent-installations:check": "pnpm --filter @attention/cli exec tsx ../../scripts/sync-agent-installation-artifacts.ts --check",
    "agent-installations:sync": "pnpm --filter @attention/cli exec tsx ../../scripts/sync-agent-installation-artifacts.ts",
    "cli-artifact:check": "pnpm --filter @attention/cli build && pnpm --filter @attention/cli exec tsx ../../scripts/sync-attention-cli-artifact.ts --check",
    "cli-artifact:sync": "pnpm --filter @attention/cli build && pnpm --filter @attention/cli exec tsx ../../scripts/sync-attention-cli-artifact.ts",
    "capabilities:check": "pnpm --filter @attention/cli exec tsx ../../scripts/sync-attention-capability-artifacts.ts --check",
    "capabilities:sync": "pnpm --filter @attention/cli exec tsx ../../scripts/sync-attention-capability-artifacts.ts",
    "dev": "pnpm --filter @attention/web dev",
    "dev:fetcher": "pnpm --filter @attention/fetcher dev",
    "dev:wechat": "pnpm --filter @attention/wechat-adapter dev",
    "dev:worker": "pnpm --filter @attention/worker dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e:ui": "playwright test tests/e2e",
    "test:e2e:resend": "pnpm --filter @attention/web test:e2e:resend",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @attention/db generate",
    "db:migrate": "pnpm --filter @attention/db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
