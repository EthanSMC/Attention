DATABASE_URL=postgresql://localhost/attention_dev
MIGRATION_DATABASE_URL=postgresql://attention_migration_owner@localhost/attention_dev
ATTENTION_MIGRATION_DATABASE_ROLE=attention_migration_owner
ATTENTION_MIGRATION_DATABASE_HOST=localhost
ATTENTION_MIGRATION_DATABASE_NAME=attention_dev
ATTENTION_WEB_DATABASE_ROLE=attention_web_runtime
WORKER_DATABASE_URL=postgresql://localhost/attention_dev
ATTENTION_WORKER_DATABASE_ROLE=attention_worker_runtime
ATTENTION_HMAC_SECRET=replace-with-at-least-32-random-characters
ATTENTION_AUTH_SECRET=replace-with-a-separate-32-character-auth-secret
ATTENTION_CHANNEL_SECRET=replace-with-a-separate-32-character-channel-secret
ATTENTION_CHANNEL_ADAPTER_SECRET=replace-with-an-internal-adapter-bearer-secret
# Independent official-account callback adapter. These values come from the
# WeChat Official Account admin console; never expose them to the browser.
ATTENTION_CHANNEL_API_BASE_URL=http://127.0.0.1:3000
# WECHAT_APP_ID=wx0000000000000000
# WECHAT_APP_SECRET=replace-with-wechat-app-secret
# WECHAT_CALLBACK_TOKEN=replace-with-wechat-callback-token
# WECHAT_ENCODING_AES_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# WECHAT_ORIGINAL_ID=gh_xxxxxxxxxxxx
# WECHAT_MESSAGE_MODE=compatible
# WECHAT_ASYNC_REPLY_PROVIDER=disabled
# WECHAT_API_BASE_URL=https://api.weixin.qq.com
# WECHAT_ADAPTER_HOST=127.0.0.1
# WECHAT_ADAPTER_PORT=4200
FETCHER_BASE_URL=http://127.0.0.1:4100
FETCHER_SHARED_SECRET=replace-with-at-least-32-random-characters
FETCHER_MAX_CONCURRENCY=16
FETCHER_MAX_QUEUE=32
FETCHER_QUEUE_TIMEOUT_MS=1000
# Optional OpenAI-compatible provider. Without a model, metadata and Agent
# keyword retrieval remain available while generated summaries are unavailable.
# ATTENTION_AI_MODEL=your-model-name
# ATTENTION_AI_BASE_URL=https://api.openai.com/v1
# ATTENTION_AI_API_KEY=replace-with-provider-key
# ATTENTION_AI_TIMEOUT_MS=20000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PUBLIC_FEED_PREVIEW_LIMIT=20

# Local demonstration only. Production should use "webhook" with a real checkout adapter.
ATTENTION_BILLING_PROVIDER=demo
ATTENTION_MEMBER_PRICE_LABEL=待定价
ATTENTION_MEMBER_FIRST_CHARGE_LABEL=待定价
ATTENTION_MEMBER_BILLING_INTERVAL_LABEL=按年自动续费
# ATTENTION_BILLING_CHECKOUT_WEBHOOK=https://billing.example.com/attention/checkout
# ATTENTION_BILLING_WEBHOOK_SECRET=replace-with-provider-secret
# Growth tokens default to 30 days. Consumer invites allow 1..365; Filter codes 1..90.
ATTENTION_CONSUMER_INVITE_TTL_DAYS=30
# Successful Consumer invite quota per eligible account; the account page shows used / total.
ATTENTION_CONSUMER_INVITE_QUOTA=1
ATTENTION_FILTER_CODE_TTL_DAYS=30

# Web login OTP supports console, webhook, or the native Resend provider. Console is development-only;
# browser responses never include the code, and live email E2E must explicitly use Resend.
# Worker digests continue to use console/webhook; digest webhook requests use
# template=attention-daily-digest-v1 and an Idempotency-Key.
ATTENTION_EMAIL_PROVIDER=console
# ATTENTION_EMAIL_WEBHOOK_URL=https://mailer.example.com/send-attention-email
# ATTENTION_EMAIL_WEBHOOK_TOKEN=replace-with-mailer-token
# Native Resend is for the unified login OTP only. The same neutral template is
# used for registration, login, re-verification, and password-reset verification.
# RESEND_API_KEY=replace-with-dedicated-resend-api-key
# ATTENTION_RESEND_FROM="Attention <no_reply@service.noveltystudio.cn>"
# ATTENTION_RESEND_TEMPLATE_ID=attention-login-code
ATTENTION_DIGEST_WORKER_ENABLED=true
DIGEST_POLL_INTERVAL_MS=60000
DIGEST_BATCH_SIZE=50
DIGEST_MAX_ATTEMPTS=8

# Defaults to NEXT_PUBLIC_APP_URL + /mcp.
ATTENTION_MCP_PUBLIC_URL=http://localhost:3000/mcp
# Defaults to NEXT_PUBLIC_APP_URL + /api/sync.
ATTENTION_SYNC_PUBLIC_URL=http://localhost:3000/api/sync
# Defense in depth; also enforce per-IP rate limits at the edge.
ATTENTION_OAUTH_REGISTRATION_HOURLY_LIMIT=100
ATTENTION_OAUTH_REGISTRATION_SOURCE_HOURLY_LIMIT=10
# Per active Filter, 1..100 new moderation cases in a rolling 24-hour window.
ATTENTION_FILTER_REPORT_CASE_LIMIT_24H=10
# Production ingress must strip and overwrite this dedicated header with the
# connection source. Never configure a client-controlled forwarding header.
# ATTENTION_TRUSTED_CLIENT_SOURCE_HEADER=x-attention-client-source
