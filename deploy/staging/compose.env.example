# Review-only staging example. Use generate-env.sh for real secret generation.
COMPOSE_PROJECT_NAME=attention-staging
ATTENTION_POSTGRES_DATA_PATH=/data/attention-staging/postgres
ATTENTION_BACKUP_DIR=/data/attention-staging/backups

POSTGRES_DB=attention_staging
POSTGRES_USER=attention_migration_owner
POSTGRES_PASSWORD=replace-me-owner-password
MIGRATION_DATABASE_URL=postgresql://attention_migration_owner:replace-me-owner-password@postgres:5432/attention_staging
ATTENTION_MIGRATION_DATABASE_ROLE=attention_migration_owner
ATTENTION_MIGRATION_DATABASE_HOST=postgres
ATTENTION_MIGRATION_DATABASE_NAME=attention_staging
ATTENTION_WEB_DATABASE_PASSWORD=replace-me-web-runtime-password
ATTENTION_WORKER_DATABASE_PASSWORD=replace-me-worker-runtime-password
DATABASE_URL=postgresql://attention_web_runtime:replace-me-web-runtime-password@postgres:5432/attention_staging
WORKER_DATABASE_URL=postgresql://attention_worker_runtime:replace-me-worker-runtime-password@postgres:5432/attention_staging

ATTENTION_HMAC_SECRET=replace-me-independent-hmac-secret
ATTENTION_AUTH_SECRET=replace-me-independent-auth-secret
ATTENTION_CHANNEL_SECRET=replace-me-independent-channel-secret
ATTENTION_CHANNEL_ADAPTER_SECRET=replace-me-independent-adapter-secret
FETCHER_SHARED_SECRET=replace-me-independent-fetcher-secret
FETCHER_MAX_CONCURRENCY=8
FETCHER_MAX_QUEUE=16
FETCHER_QUEUE_TIMEOUT_MS=1000

NEXT_PUBLIC_APP_URL=https://attention-staging.noveltystudio.cn
ATTENTION_MCP_PUBLIC_URL=https://attention-staging.noveltystudio.cn/mcp
ATTENTION_SYNC_PUBLIC_URL=https://attention-staging.noveltystudio.cn/api/sync
PUBLIC_FEED_PREVIEW_LIMIT=20
ATTENTION_TRUSTED_CLIENT_SOURCE_HEADER=x-attention-client-source
ATTENTION_OAUTH_REGISTRATION_HOURLY_LIMIT=100
ATTENTION_OAUTH_REGISTRATION_SOURCE_HOURLY_LIMIT=10
ATTENTION_FILTER_REPORT_CASE_LIMIT_24H=10
ATTENTION_CONSUMER_INVITE_QUOTA=1
WEB_BIND_ADDRESS=127.0.0.1
WEB_PUBLISH_PORT=9199

ATTENTION_EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-me-with-a-new-rotated-resend-key
ATTENTION_RESEND_FROM="Attention <no_reply@service.noveltystudio.cn>"
ATTENTION_RESEND_TEMPLATE_ID=login-code-attention
ATTENTION_EMAIL_WEBHOOK_URL=
ATTENTION_EMAIL_WEBHOOK_TOKEN=
ATTENTION_DIGEST_WORKER_ENABLED=false

ATTENTION_AI_MODEL=
ATTENTION_AI_BASE_URL=https://api.openai.com/v1
ATTENTION_AI_API_KEY=
ATTENTION_BILLING_PROVIDER=
ATTENTION_BILLING_CHECKOUT_WEBHOOK=
ATTENTION_BILLING_WEBHOOK_SECRET=

ATTENTION_CHANNEL_API_BASE_URL=https://attention-staging.noveltystudio.cn
WECHAT_BIND_ADDRESS=127.0.0.1
WECHAT_PUBLISH_PORT=9299
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=replace-me-inactive-wechat-secret
WECHAT_CALLBACK_TOKEN=replace-me-inactive-wechat-token
WECHAT_ENCODING_AES_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
WECHAT_MESSAGE_MODE=safe
WECHAT_ASYNC_REPLY_PROVIDER=disabled
