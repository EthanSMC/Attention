{
  "name": "@attention/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/enqueue.ts",
    "./contracts": "./src/contracts.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit --rootDir ../.."
  },
  "dependencies": {
    "@attention/collector": "workspace:*",
    "@attention/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "esbuild": "^0.28.1",
    "tsx": "latest",
    "typescript": "^6.0.3"
  }
}
