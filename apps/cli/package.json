{
  "name": "@attention/cli",
  "version": "0.3.11",
  "private": false,
  "type": "module",
  "bin": {
    "attention": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22.16 --preserve-symlinks --banner:js='#!/usr/bin/env node' --outfile=dist/index.js && node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@attention/contracts": "workspace:*",
    "uqr": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "latest",
    "esbuild": "^0.28.1",
    "tsx": "latest",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "files": [
    "dist/index.js",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
